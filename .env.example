# ============================================================================
# NyayaVault environment — CLIENT variables only in this file.
# Anything that grants write power or costs money NEVER goes here.
# ============================================================================

# Supabase (anon key is public-by-design; RLS does the real enforcement)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider for in-browser assistants (demo conveniences only).
# Production AI calls go through Edge Functions with server-side keys.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-flash-latest

# ----------------------------------------------------------------------------
# SERVER-ONLY — set as Supabase Edge Function secrets, NEVER in .env.local:
#
#   supabase secrets set \
#     ANCHOR_WALLET_PRIVATE_KEY=0x... \
#     AMOY_RPC_URL=https://rpc-amoy.polygon.tech \
#     DOCUMENT_ANCHOR_ADDRESS=0x... \
#     SOLAR_API_KEY=up_...        # or GEMINI_API_KEY
#
# ANCHOR_WALLET_PRIVATE_KEY : burner wallet funded with Amoy test MATIC only
# SOLAR_API_KEY             : Upstage Solar key (classify-document, semantic-search)
# GEMINI_API_KEY            : fallback provider if Solar is not used
# ----------------------------------------------------------------------------
